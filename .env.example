# ─────────────────────────────────────────────────────────────────────────────
# WTM — Asistente IA para WhatsApp (gestión de citas)
# Copia este archivo a `.env` y reemplaza TODO lo que empiece por "cambia_esto".
#   cp .env.example .env
# `.env` está en .gitignore: nunca lo subas al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ───── Aplicación ─────
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
TZ=UTC                              # los timestamps se guardan en UTC

# ───── PostgreSQL (una instancia, dos bases: app y evolution) ─────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto_postgres_superuser
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
APP_DB_NAME=app
APP_DB_USER=app
APP_DB_PASSWORD=cambia_esto_app
EVOLUTION_DB_PASSWORD=cambia_esto_evolution

# ───── Redis ─────
# Cola de ARQ: persistencia AOF y política noeviction (no se toca).
REDIS_QUEUE_URL=redis://redis-queue:6379/0
# Caché de Evolution: separado de la cola, puede expulsar claves.
REDIS_EVOLUTION_URL=redis://redis-evolution:6379/6

# ───── Evolution API (canal WhatsApp por QR) ─────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=cambia_esto_evolution_api_key

# ───── Webhooks ─────
# Secreto base para validar los webhooks de Evolution (se deriva uno por negocio).
WEBHOOK_SECRET=cambia_esto_webhook_secret
# Token del API de administración. Si se deja vacío se usa WEBHOOK_SECRET.
ADMIN_TOKEN=

# ───── LLM ─────
LLM_PROVIDER=openrouter             # openrouter | openai | anthropic | other
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=cambia_esto_openrouter_api_key
# Modelo económico por defecto en desarrollo (el definitivo se decide con datos
# de llm_usage). Ejemplo: openai/gpt-4.1-mini
LLM_MODEL=
# Modelo de respaldo: implementado, APAGADO.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_ENABLED=false
LLM_TIMEOUT_S=60
LLM_MAX_ITERATIONS=6

# ───── Transcripción de voz (complemento, opcional) ─────
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=

# ───── Telegram (consola del dueño, opcional por negocio) ─────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ───── Respaldos ─────
BACKUP_DIR=/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# ───── Dominios (Caddy, solo producción) ─────
DOMAIN_API=
DOMAIN_EVO=
